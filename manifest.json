{
  "manifest_version": 3,
  "name": "YouTube Speed Control",
  "version": "3.1.1",
  "description": "Mantem a velocidade escolhida e volta ao normal ao alcancar o ponto ao vivo.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "YouTube Speed Control",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
